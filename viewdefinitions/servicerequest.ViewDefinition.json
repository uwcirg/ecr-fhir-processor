{
  "resourceType": "ViewDefinition",
  "id": "servicerequest",
  "name": "servicerequest_view",
  "status": "active",
  "resource": "ServiceRequest",
  "description": "Flattened analytics view: one row per first-class ServiceRequest persisted by this project. Default column set is an informed, reviewable default (FR-002), not a finalized analytics-team contract.",
  "select": [
    {
      "column": [
        { "name": "id", "path": "getResourceKey()", "type": "string" },
        { "name": "status", "path": "status", "type": "code" },
        { "name": "intent", "path": "intent", "type": "code" },
        { "name": "category", "path": "category.first().coding.first().code", "type": "code" },
        { "name": "code", "path": "code.coding.first().code", "type": "code" },
        { "name": "code_display", "path": "code.coding.first().display", "type": "string" },
        { "name": "subject", "path": "subject.reference", "type": "string" },
        { "name": "encounter", "path": "encounter.reference", "type": "string" },
        { "name": "authored_on", "path": "authoredOn", "type": "dateTime" },
        { "name": "requester", "path": "requester.reference", "type": "string" },
        { "name": "cms_measure", "path": "meta.tag.where(system = 'https://uwcirg.github.io/ecr-fhir-processor/CodeSystem/cms-measure').code.first()", "type": "code" }
      ]
    }
  ],
  "where": [
    {
      "path": "meta.tag.where(system = 'https://uwcirg.github.io/ecr-fhir-processor/CodeSystem/processed-by' and code = 'ecr-fhir-processor').exists()",
      "description": "Scope the view to ServiceRequests persisted by this project's processor (FR-005): match this processor's provenance tag (processed-by = ecr-fhir-processor), version-agnostic. Excludes unrelated ServiceRequest resources on the same server."
    }
  ]
}
